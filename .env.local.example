# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key is SECRET — server-side only, used by the admin panel
# to assign departments/roles to users. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
